{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": "dist",        
    "noEmit": false,
    "paths": {
      "@db/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}