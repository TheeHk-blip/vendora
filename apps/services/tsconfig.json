{
  "compilerOptions": {   
    "rootDir": "./src",
    "outDir": "./dist", 
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "types": [],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "paths": {
      "@vendora/db": ["../../packages/db/src/backend.ts"],
      "@db/*": ["../../packages/db/dist/*.js"]
    }
  },
  "references": [
    { "path": "../../packages/db"}
  ]
}
